{
  "name": "ng-platform-workspace-design-system",
  "version": "0.0.0",
  "lint-staged": {
    "*.{html,json,css,scss,js,cjs,mjs,ts,tsx}": "npx prettier --check",
    "*.{js,cjs,mjs,ts,tsx}": "npx eslint --quiet",
    "*.{css,scss}": "npx stylelint"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build spr-components",
    "build:prod": "ng build spr-components --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest --ci --coverage --selectProjects spr-components-v2",
    "test:watch": "jest --watch --selectProjects spr-components",
    "lint": "ng lint spr-components",
    "stylelint": "npx stylelint \"projects/spr-components/**/*.scss\"",
    "prettier:check": "npx prettier --check projects/spr-components/.",
    "prettier:fix": "npx prettier --write projects/spr-components/.",
    "storybook": "ng run spr-components:storybook",
    "build-storybook": "ng run spr-components:build-storybook",
    "build:v2": "ng build spr-components-v2",
    "build:prod:v2": "ng build spr-components-v2 --configuration production",
    "test:v2": "jest --ci --coverage --selectProjects spr-components-v2",
    "test:watch:v2": "jest --watch --selectProjects spr-components-v2",
    "lint:v2": "ng lint spr-components-v2",
    "stylelint:v2": "npx stylelint \"projects/spr-components-v2/**/*.scss\"",
    "prettier:check:v2": "npx prettier --check projects/spr-components-v2/.",
    "prettier:fix:v2": "npx prettier --write projects/spr-components-v2/.",
    "storybook:v2": "ng run spr-components-v2:storybook",
    "build-storybook:v2": "ng run spr-components-v2:build-storybook",
    "build:grid": "ng build spr-grid",
    "build:prod:grid": "ng build spr-grid --configuration production",
    "test:grid": "jest --ci --coverage --selectProjects spr-grid",
    "test:watch:grid": "jest --watch --selectProjects spr-grid",
    "lint:grid": "ng lint spr-grid",
    "stylelint:grid": "npx stylelint \"projects/spr-grid/**/*.scss\"",
    "prettier:check:grid": "npx prettier --check projects/spr-grid/.",
    "prettier:fix:grid": "npx prettier --write projects/spr-grid/.",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.6",
    "@angular/cdk": "^19.2.9",
    "@angular/common": "^19.2.6",
    "@angular/compiler": "^19.2.6",
    "@angular/core": "^19.2.6",
    "@angular/forms": "^19.2.6",
    "@angular/platform-browser": "^19.2.6",
    "@angular/platform-browser-dynamic": "^19.2.6",
    "@angular/router": "^19.2.6",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@maskito/angular": "^5.0.1",
    "@maskito/core": "^5.0.1",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@platform-workspace/bo-icons": "^1.0.6",
    "ag-grid-angular": "^34.2.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^4.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "19.2.1",
    "@angular-eslint/eslint-plugin": "19.2.1",
    "@angular-eslint/eslint-plugin-template": "19.2.1",
    "@angular-eslint/schematics": "19.2.1",
    "@angular-eslint/template-parser": "19.2.1",
    "@angular/build": "^19.2.7",
    "@angular/cli": "^19.2.7",
    "@angular/compiler-cli": "^19.2.6",
    "@chromatic-com/storybook": "^1.9.0",
    "@storybook/addon-actions": "^8.6.12",
    "@storybook/addon-backgrounds": "^8.6.12",
    "@storybook/addon-docs": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/angular": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/manager-api": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@storybook/theming": "^8.6.12",
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.14",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@typescript-eslint/parser": "8.29.1",
    "@typescript-eslint/utils": "8.29.1",
    "big.js": "^6.2.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^14.5.3",
    "lint-staged": "^16.1.6",
    "ng-packagr": "^19.2.2",
    "prettier": "^3.3.3",
    "storybook": "^8.1.0",
    "stylelint": "^16.6.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-selector-bem-pattern": "^4.0.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9"
  }
}
